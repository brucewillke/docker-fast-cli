# Use Alpine-based Node image
FROM node:26.2.0-alpine

# Install Chromium, dependencies, and create non-root user in one layer
RUN apk add --no-cache chromium nss ca-certificates && \
    adduser -D docker && \
    mkdir -p /home/docker/app && \
    chown -R docker:docker /home/docker

# Set Puppeteer to use system-installed Chromium
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

USER docker
WORKDIR /home/docker/app

# Install dependencies and clean cache
RUN echo '{ "name": "myapp", "version": "1.0.0", "dependencies": { "fast-cli": "^3.0.0" } }' > package.json && \
    npm install && \
    npm cache clean --force

# Print startup message then run the command
ENTRYPOINT ["sh", "-c", "echo 'Starting speed test...' && exec \"$@\"", "--"]
CMD ["npx", "fast", "-u"]

